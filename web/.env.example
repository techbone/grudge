# "local" = anvil fork from scripts/dev-chain.sh (chain 31337). Leave empty for Monad mainnet.
NEXT_PUBLIC_CHAIN=local
# Grudge contract address. scripts/dev-chain.sh writes this into .env.local for you.
NEXT_PUBLIC_GRUDGE_ADDRESS=
# Optional: a faster Monad RPC for mainnet reads.
NEXT_PUBLIC_MONAD_RPC_URL=
